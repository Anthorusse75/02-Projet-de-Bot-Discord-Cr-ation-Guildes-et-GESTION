# Local-only, non-sensitive development defaults. Copy to .env.local if needed.
DID_APP_ENV=development
DID_DATABASE_URL=postgresql+asyncpg://did_app:local_app_password@localhost:5432/did
DID_DATABASE_ADMIN_URL=postgresql+asyncpg://did_admin:local_admin_password@localhost:5432/did
DID_REDIS_URL=redis://localhost:6379/0
DID_LOG_LEVEL=INFO
DID_HEALTH_TIMEOUT_SECONDS=2.0
