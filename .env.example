# Local-only, non-sensitive development defaults. Copy to .env.local if needed.
DID_APP_ENV=development
DID_DATABASE_URL=postgresql+asyncpg://did_app:local_app_password@localhost:5432/did
DID_DATABASE_ADMIN_URL=postgresql+asyncpg://did_admin:local_admin_password@localhost:5432/did
DID_REDIS_URL=redis://localhost:6379/0
DID_LOG_LEVEL=INFO
DID_HEALTH_TIMEOUT_SECONDS=2.0
# Configure these for the real local Discord/OAuth flow. Never commit real values.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
DISCORD_TEST_GUILD_A_ID=
DISCORD_TEST_GUILD_B_ID=
SESSION_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
DID_OAUTH_TOKEN_KEY_VERSION=1

# Optional in Phase 2. When absent, the UI disables Templates / Library / Clone
# instead of letting those screens fail with a PORTABILITY_NOT_CONFIGURED 503.
# Generate/store a real base64 key only in .env.local; never commit it.
ARTIFACT_ENCRYPTION_KEY=
DID_ARTIFACT_ENCRYPTION_KEY_VERSION=1
